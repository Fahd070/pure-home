// TEMPORARY, standalone latency-benchmark schema. The only DB operation this
// tool ever performs is a raw `SELECT 1` (see index.js) -- there is nothing
// here for Prisma to migrate, create, or alter. Not part of the Pure Home
// application schema and not used by packages/backend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generation-only placeholder: Prisma 5.22's client generator refuses to run
// against a schema with zero models. This model is never queried -- index.js
// only ever calls prisma.$queryRaw`SELECT 1` -- and no migration is created
// or run for it, so it never touches the production database.
model BenchmarkPlaceholder {
  id Int @id

  @@map("__benchmark_placeholder_never_queried")
}
