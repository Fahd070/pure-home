{
  "name": "water-filter-maintenance",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:web": "npm run dev --workspace=packages/web",
    "dev:unified": "npm run dev --workspace=packages/unified-app",
    "build:web": "npm run build --workspace=packages/web",
    "build:backend": "npm run build --workspace=packages/backend",
    "build:unified": "npm run build --workspace=packages/unified-app",
    "build:all": "npm run build:backend && npm run build:web",
    "db:generate": "npm run db:generate --workspace=packages/backend",
    "db:migrate": "npm run db:migrate --workspace=packages/backend",
    "db:seed": "npm run db:seed --workspace=packages/backend",
    "test:backend": "npm run test --workspace=packages/backend"
  },
  "devDependencies": {
    "@babel/compat-data": "^7.29.7",
    "@babel/helper-globals": "^7.29.7",
    "@babel/runtime": "^7.23.2",
    "@electron-internal/extract-zip": "^1.0.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.4",
    "@isaacs/fs-minipass": "^4.0.0",
    "@peculiar/webcrypto": "^1.7.1",
    "@tsconfig/node10": "^1.0.7",
    "@tsconfig/node12": "^1.0.7",
    "@tsconfig/node14": "^1.0.0",
    "@tsconfig/node16": "^1.0.2",
    "asn1js": "^3.0.10",
    "aws4": "^1.13.2",
    "dunder-proto": "^1.0.1",
    "electron-winstaller": "5.4.0",
    "estree-walker": "^3.0.3",
    "math-intrinsics": "^1.1.0",
    "node-int64": "^0.4.0",
    "node-releases": "^2.0.51",
    "pkijs": "^3.4.0",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "proper-lockfile": "^4.1.2",
    "resedit": "^1.7.0",
    "set-cookie-parser": "^2.7.2",
    "sharp": "^0.35.3",
    "tiny-async-pool": "1.3.0",
    "yocto-queue": "^0.1.0"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
