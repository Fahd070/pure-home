generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SCHEDULING
  TECHNICIAN
}

enum MaintenanceCycle {
  DAILY
  WEEKLY
  MONTHLY
}

enum AppointmentType {
  INSTALLATION
  MAINTENANCE
}

enum AppointmentStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  PENDING
}


model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  // v4 Requirement #12: per-technician access code, replacing the single shared
  // department code that made every technician authenticate as one User row.
  // Stored as a bcrypt hash using the SAME hashing the `password` field above
  // already uses -- deliberately not a new hashing scheme, and deliberately not
  // reversible: Administration can SET or REPLACE a code but can never read one
  // back (see routes/employees.ts, which never selects this column into any
  // response). Nullable so every existing user stays valid with no value, and so
  // a technician with no code set simply falls back to the legacy shared
  // department code -- which is what keeps employees on Desktop v3.6.5 able to
  // log in throughout this transition (see services/technicianIdentity.service.ts).
  accessCodeHash  String?
  // When the access code was last set/replaced. Purely informational -- shown to
  // Administration as "code set" vs "no code yet" state without ever revealing
  // the code itself.
  accessCodeSetAt DateTime?
  // v4 decision D9: server-enforced session revocation.
  //
  // Every issued JWT carries the value this field had at login. middleware/auth.ts
  // compares the token's copy against the stored one on every request, so bumping
  // this immediately invalidates every token issued before the bump -- across
  // process restarts and across multiple backend instances, because the source of
  // truth is a database row rather than an in-memory blacklist.
  //
  // Bumped when Administration deactivates a technician and when their access
  // code is changed. Deliberately an Int rather than a timestamp: comparison is
  // exact equality with no clock-skew or precision question, and a monotonically
  // increasing counter cannot be accidentally rewound by a clock change.
  sessionVersion  Int       @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customersCreated     Customer[]           @relation("CustomerCreatedBy")
  appointmentsCreated  Appointment[]        @relation("AppointmentCreatedBy")
  assignedAppointments Appointment[]        @relation("AppointmentTechnician")
  postponements        PostponementRecord[] @relation("PostponementTechnician")
  notifications        Notification[]
  auditLogs            AuditLog[]
  messages             Message[]
  sentDirectMessages   DirectMessage[]      @relation("DMSender")
  callReports          CallReport[]         @relation("CallReportCreatedBy")
  expenses             Expense[]            @relation("ExpenseByTechnician")
  urgentVisits         UrgentVisitRecord[]  @relation("UrgentVisitBy")
  noAnswerRecords      CustomerNoAnswerRecord[] @relation("NoAnswerRecordedBy")
  @@map("users")
}

model Customer {
  id                   String           @id @default(uuid())
  name                 String
  phone                String
  // Optional second contact number. Nullable so every existing customer stays
  // valid with no value; same 05XXXXXXXX format as `phone` when present, and
  // must differ from it (enforced at the API layer, not the DB, matching this
  // schema's existing convention of validating business rules in the routes).
  secondaryPhone       String?
  maintenanceCycle     MaintenanceCycle
  // Part D: recurrence must support half-month increments (1, 1.5, 2, 2.5, ...).
  // Float (Postgres DOUBLE PRECISION) rather than Decimal -- every value this
  // column will ever hold is a positive multiple of 0.5 (enforced by Zod's
  // half-step refine in routes/customers.ts), and 0.5 is exactly representable
  // in IEEE-754 double precision (binary fraction 2^-1), so there is no
  // rounding/precision-loss risk for this restricted value set. Kept as a
  // plain JS number end-to-end (unlike Prisma's Decimal type, which would
  // require Decimal-object handling through every read site) -- smallest safe
  // change compatible with the existing Int-typed call sites.
  maintenanceFrequency Float            @default(1)
  isActive             Boolean          @default(true)
  activityDismissed    Boolean          @default(false)
  notes                String?
  installationDate     DateTime?
  // Optional installation-details section (Admin + Scheduling). Deliberately
  // separate from `notes` (the general customer-notes field) so installation
  // context never gets mixed into or overwritten by unrelated notes, and
  // separate from Appointment's completion financial fields (completionAmount/
  // completionPaymentMethod) since this is not tied to any specific
  // appointment. All three are independently optional -- no field here
  // requires another to be set (unlike previousService* below, which is an
  // all-or-nothing group). installationPaymentMethod is a plain validated
  // string tag (CASH / BANK_CARD_PERSONAL / BANK_CARD_COMMERCIAL), matching
  // this schema's existing convention for small business-validated tags
  // (see previousServiceType, Appointment.completionPaymentMethod) rather
  // than a dedicated Prisma enum for three optional values.
  installationNote          String?
  installationAmount        Float?
  installationPaymentMethod String?
  // Optional, one-time historical record of a service that happened BEFORE
  // this customer existed in the system. Deliberately plain nullable fields
  // (not a Prisma enum, not a separate history table) -- matches this
  // schema's existing convention for a small, business-validated "type tag"
  // (see Appointment.completionPaymentMethod) rather than the true
  // AppointmentType enum, since this is explicitly NOT an Appointment and
  // must never be confused with one. All three are null together or set
  // together (enforced at the API layer): a half-record such as a date with
  // no type is rejected before it reaches the database.
  previousServiceType  String?
  previousServiceDate  DateTime?
  previousServiceNote  String?
  // v4 Requirement #4 (decision D1): the MATERIALIZED next-maintenance due date.
  //
  // Never authoritative in its own right and never hand-edited: it is written
  // exclusively by recalculateCustomerMaintenanceDue() in
  // services/maintenanceSchedule.service.ts, which is itself the single source
  // of truth for this date math. It exists only because a value computed in
  // JavaScript cannot appear in a SQL ORDER BY, and Requirement #9 needs
  // overdue-first ordering applied BEFORE the page slice -- sorting after
  // pagination would silently show the wrong customers on every page but the
  // first. Materializing it additionally turns the dashboard's due buckets
  // (Requirement #4) into plain indexed counts instead of loading every
  // customer's appointment history on every dashboard load.
  //
  // Nullable, and null is meaningful: it means "no baseline exists from which a
  // due date could be derived" (no completed maintenance, no recorded previous
  // service, no installation date). Such customers are deliberately NOT given a
  // fabricated date -- they sort last and render as "—" rather than appearing
  // falsely overdue. Because the value is fully derived, it can be recomputed
  // from scratch at any time, which is what makes both the backfill and a
  // rollback safe.
  nextMaintenanceDueAt DateTime?
  version              Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdById          String?
  createdBy            User?            @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  address              Address?
  appointments         Appointment[]
  callReports          CallReport[]
  branches             CustomerBranch[]
  @@map("customers")
}

// v4 Requirement #8: a customer may optionally operate from several branches.
//
// Domain rule, deliberately encoded by this shape: ONE CUSTOMER REMAINS ONE
// CUSTOMER. Branches are detail records hanging off the customer, never
// additional Customer rows -- so a multi-branch customer still appears exactly
// once in every customer list, count, report and maintenance calculation.
//
// Appointments are deliberately NOT linked to a branch in this phase. The
// approved scope treats branches as customer detail information only, and
// adding an appointment->branch foreign key now would force every existing
// appointment into a "which branch?" question that the business has not yet
// answered.
model CustomerBranch {
  id               String   @id @default(uuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // The only required detail: a branch with no name cannot be told apart from
  // another branch in any list. Every other field is genuinely optional, so a
  // customer can record "we have three branches" and fill in supervisor
  // contacts later.
  branchName       String
  supervisorName   String?
  supervisorMobile String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // Justified, not speculative: this is the ONLY access pattern the table has
  // (load one customer's branches), and it is also what makes the Cascade above
  // an indexed delete rather than a sequential scan of every branch row on each
  // customer deletion. Mirrors how `Address.customerId` is already indexed via
  // its @unique.
  @@index([customerId])
  @@map("customer_branches")
}

model Address {
  id          String   @id @default(uuid())
  city        String
  district    String
  street      String
  postalCode  String?
  buildingNo  String?
  floorNo     String?
  apartmentNo String?
  customerId  String   @unique
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@map("addresses")
}

model Appointment {
  id                  String            @id @default(uuid())
  type                AppointmentType
  status              AppointmentStatus @default(SCHEDULED)
  scheduledDate       DateTime
  notes               String?
  urgentLocation      String?
  isUrgent            Boolean           @default(false)
  adminApproved       Boolean           @default(false)
  visibleToScheduling Boolean           @default(true)
  // Modification #5: Scheduling/Maintenance -> Admin approval -> Technician
  // export workflow. Defaults true so every existing appointment (and every
  // ordinarily-created one going forward) stays immediately technician-visible,
  // exactly as before -- this field only ever goes false for the narrow window
  // between an explicit export action and its Admin approval. adminApproved is
  // reused for the same flow (it was already generically named and effectively
  // unused/always-false for Scheduling-created appointments, which is the only
  // creator role the export/approve endpoints operate on); its pre-existing use
  // for the separate Admin<->Scheduling visibleToScheduling approval flow is
  // untouched.
  visibleToTechnician Boolean           @default(true)
  createdByRole       String?
  version             Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  technicianId        String?
  technician          User?             @relation("AppointmentTechnician", fields: [technicianId], references: [id])
  workStatus          String            @default("WAITING")
  workNotes           String?
  serviceDetails      String?
  completionAmount    Float?
  completionPaymentMethod String?
  completionImage     String?           @db.Text
  // Modification #6: technician-recorded note about what to check/prepare for the
  // customer's NEXT maintenance visit. Unlike completionAmount, this is not
  // financial data -- visible to Admin/Technician/Scheduling alike. A later
  // modification (#7) will surface it automatically when scheduling the next
  // appointment; for now it is just persisted and readable via the existing
  // appointment/customer APIs.
  nextMaintenanceNote String?
  // Modification #8: the Technician-declared ACTUAL date the maintenance
  // operation took place -- distinct from `completedAt`, which continues to
  // mean "when the completion submission was received by the server" and is
  // never touched by this field. Plain DateTime (no @db.Date), matching this
  // schema's existing convention for date-only business fields (see
  // Customer.installationDate) -- stored as the date the technician selected,
  // parsed the same simple way.
  actualCompletionDate DateTime?
  // Modification #8: whether Scheduling/Maintenance has reviewed and explicitly
  // confirmed a Technician's completion report (completion date + non-financial
  // completion details). Defaults false so every existing completed appointment
  // (and every new completion going forward) starts unconfirmed until Scheduling
  // acts -- Technician completion submission must never set this true itself.
  // Deliberately its own field, not a repurposing of adminApproved (Modification
  // #5's distinct Admin export-approval flow) or visibleToTechnician.
  maintenanceConfirmed Boolean           @default(false)
  // Completion-record field only: the first name the Technician actually typed
  // into the "Technician Name" field at the moment of a NORMAL (non-urgent)
  // completion. Deliberately separate from the `technician` relation above --
  // that relation remains the sole source of truth for permissions, ownership,
  // and audit identity, and is never derived from this string. Nullable so
  // every pre-existing completed appointment (submitted before this field
  // existed) stays valid; the Admin Technicians completion-details view falls
  // back to the technician relation's first name when this is null.
  completionTechnicianName String?
  startedAt           DateTime?
  completedAt         DateTime?
  customerId          String?
  // Recorded decision: SET NULL (not Cascade) so appointment history survives a
  // customer deletion. Production's raw-SQL startup helper had been silently
  // re-asserting CASCADE on every boot -- confirmed via read-only metadata query
  // before this change (see migration 20260627000000_appointments_customer_fk_set_null).
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById         String?
  createdBy           User?             @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  postponements       PostponementRecord[]
  noAnswerRecords     CustomerNoAnswerRecord[]
  urgentVisitRecord   UrgentVisitRecord?
  @@map("appointments")
}

model PostponementRecord {
  id            String      @id @default(uuid())
  reason        String
  newDate       DateTime?
  // v4 Requirement #6 (decision D2): the appointment's scheduledDate as it was
  // immediately BEFORE this postponement moved it. Postponement is now a genuine
  // reschedule -- the appointment's own scheduledDate is overwritten with the new
  // agreed date -- so without capturing the old value here, "postponed from X to
  // Y" becomes unanswerable the moment the write lands. This record is therefore
  // the durable history, and it survives every later change to the appointment.
  //
  // Nullable because every PostponementRecord written before this field existed
  // has no captured previous date; those rows render as "—" rather than being
  // retroactively invented.
  previousDate  DateTime?
  createdAt     DateTime    @default(now())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?       @relation("PostponementTechnician", fields: [requestedById], references: [id])
  @@map("postponement_records")
}

// v4 Requirement #7: "Customer Did Not Answer" as a durable operational EVENT
// rather than an appointment status.
//
// Chosen shape (documented decision -- see also routes/appointments.ts):
// treating did-not-answer as a terminal workStatus would have removed the
// appointment from the technician work queue (which filters
// workStatus WAITING,IN_PROGRESS) and from every dashboard operational bucket
// (see dashboardCategorization.service.ts, whose `active` filter uses the same
// two values) -- i.e. the one outcome that most needs follow-up would have been
// the one outcome that disappears from every follow-up surface. So the
// appointment stays actionable and the attempt is recorded here instead.
//
// Deliberately mirrors PostponementRecord's shape rather than inventing a new
// pattern: one row per attempt, so repeated failed contact attempts on the same
// appointment all survive, and Cascade so they are cleaned up with the
// appointment exactly as postponements are.
model CustomerNoAnswerRecord {
  id            String       @id @default(uuid())
  // Optional free-text note from the technician. There is deliberately no
  // technician-name field: the actor is the authenticated user below, never a
  // string the client supplies (decision D4).
  note          String?
  createdAt     DateTime     @default(now())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recordedById  String?
  recordedBy    User?        @relation("NoAnswerRecordedBy", fields: [recordedById], references: [id])
  @@map("customer_no_answer_records")
}

// The Phase 2 work (unread badges, top banners, centre critical alert cards)
// needs more than title/body/type/isRead. The additive fields below are the
// MINIMUM foundation for that, bundled into Phase 1's single migration so a
// second production migration is not required later.
//
// Deliberately NOT added, despite being proposed:
//   * `targetRole` -- notifications are already per-user rows (`userId`), and a
//     user's role is fixed, so a stored role would be a second, derivable copy
//     of the targeting that `userId` already expresses. Role isolation is
//     enforced by scoping every read to the authenticated user, not by a column.
//   * `category` -- `type` already identifies the event, and the badge grouping
//     Phase 2 needs is a mapping FROM type, not an independent value that could
//     disagree with it.
//   * `reviewedAt` -- `isRead` already expresses "the user has dealt with this",
//     and a critical alert that is acknowledged should also stop counting toward
//     its badge, which is exactly what a single flag gives.
// Each can be added later if Phase 2 proves a real need; adding them now would
// be adding columns nothing reads.
model Notification {
  id        String   @id @default(uuid())
  title     String
  body      String
  type      String
  // Selects the presentation surface in Phase 2: INFO -> sidebar badge only,
  // CRITICAL -> also a top banner and a centre alert card. A plain validated
  // string tag with a safe default rather than a Prisma enum, matching this
  // schema's existing convention for small business tags (see
  // Appointment.completionPaymentMethod) and avoiding a Postgres enum
  // alteration -- the riskiest change type against this project's migration
  // history. Existing rows all become INFO, which is correct for them.
  severity  String   @default("INFO")
  // What the notification is ABOUT, so Phase 2 can navigate from an alert to the
  // appointment/customer it concerns, and so "which customers have a
  // did-not-answer event" is a query rather than a string search. Today the
  // appointment id is embedded inside the human-readable `body` text, which is
  // not addressable.
  entityType String?
  entityId   String?
  // The FOUNDATION for Phase 2 deduplication -- not yet in use. Nothing writes
  // this today, so every row has NULL and (PostgreSQL permitting unlimited NULLs
  // in a unique index) the constraint below is currently inert.
  //
  // Stated plainly because the distinction matters: the existing cron still
  // deduplicates with `body: { contains: "[upcoming:<id>:7]" }`, a LIKE scan
  // over free text that races between its own findFirst and createMany, and that
  // race is UNCHANGED until Phase 2's producers populate this column. The column
  // and constraint ship now only so Phase 2 needs no second production migration.
  dedupeKey  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  // Scoped per user, because the same logical event legitimately produces one
  // row for each recipient. Safe to add to a populated table precisely because
  // every existing row has dedupeKey = NULL, and PostgreSQL permits unlimited
  // NULLs in a unique index.
  @@unique([userId, dedupeKey])
  @@map("notifications")
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  @@map("messages")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  beforeState Json?
  afterState  Json?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model EventLog {
  id         String   @id @default(uuid())
  eventType  String
  entityType String
  entityId   String
  userId     String
  payload    Json
  createdAt  DateTime @default(now())
  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("event_logs")
}

model DirectMessage {
  id            String   @id @default(uuid())
  content       String
  senderId      String
  sender        User     @relation("DMSender", fields: [senderId], references: [id])
  recipientRole String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  @@map("direct_messages")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@map("system_configs")
}

// No @relation to User: the underlying table (created by ensureUserSettingsTable() in
// index.ts, historically unmanaged by Prisma) has never had a foreign key on userId,
// only a unique index -- preserved as-is here rather than introducing a new constraint.
model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  theme                String   @default("light")
  fontSize             String   @default("medium")
  interfaceScale       String   @default("normal")
  background           String   @default("day")
  highContrast         Boolean  @default(false)
  improvedReadability  Boolean  @default(false)
  notificationsEnabled Boolean  @default(true)
  soundEnabled         Boolean  @default(true)
  soundVolume          Int      @default(70)
  primaryColor         String?
  secondaryColor       String?
  buttonColor          String?
  cardColor            String?
  updatedAt            DateTime @default(now())
  createdAt            DateTime @default(now())
  @@map("user_settings")
}

model CallReport {
  id           String   @id @default(uuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employeeName String
  callDate     DateTime
  notes        String?
  createdAt    DateTime @default(now())
  createdById  String?
  createdBy    User?    @relation("CallReportCreatedBy", fields: [createdById], references: [id])
  unregisteredName  String?
  unregisteredPhone String?
  @@map("call_reports")
}

model Expense {
  id               String   @id @default(uuid())
  amount           Float
  category         String
  description      String?
  date             DateTime
  receiptImage     String?
  status           String   @default("PENDING")
  invoiceGenerated Boolean  @default(false)
  technicianId     String
  technician       User     @relation("ExpenseByTechnician", fields: [technicianId], references: [id])
  createdAt        DateTime @default(now())
  @@map("expenses")
}

model UrgentVisitRecord {
  id              String      @id @default(uuid())
  appointmentId   String      @unique
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerName    String?
  customerPhone   String?
  customerDetails String?
  serviceNotes    String?
  serviceType     String?
  customerInfo    String?
  serviceDetails  String?
  notes           String?
  paymentMethod   String
  amount          Float?
  submittedById   String?
  submittedBy     User?       @relation("UrgentVisitBy", fields: [submittedById], references: [id])
  createdAt       DateTime    @default(now())
  @@map("urgent_visit_records")
}
